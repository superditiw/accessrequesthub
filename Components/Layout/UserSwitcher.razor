@using AccessRequestHub.Data
@using AccessRequestHub.Models
@using AccessRequestHub.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject CurrentUserService CurrentUserSvc
@inject IServiceProvider Sp
@rendermode InteractiveServer

<div class="user-switcher d-flex align-items-center gap-2">
    <label for="userSelect" class="text-white-50 small mb-0">Acting as:</label>
    <select id="userSelect" class="form-select form-select-sm" @onchange="OnUserSelected">
        @if (users == null)
        {
            <option>Loading...</option>
        }
        else
        {
            @foreach (var u in users)
            {
                <option value="@u.Id" selected="@(u.Id == CurrentUserSvc.User?.Id)">@u.DisplayName (@GetRoleDisplay(u))</option>
            }
        }
    </select>
</div>

@code {
    private List<User>? users;
    private List<Application>? apps;

    protected override async Task OnInitializedAsync()
    {
        using var scope = Sp.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        users = await db.Users.ToListAsync();
        apps = await db.Applications.ToListAsync();

        if (CurrentUserSvc.User == null && users.Any())
        {
            // Default to Alice
            var alice = users.FirstOrDefault(u => u.DisplayName == "Alice") ?? users.First();
            CurrentUserSvc.SetUser(alice);
        }
    }

    private void OnUserSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var userId) && users != null)
        {
            var user = users.FirstOrDefault(u => u.Id == userId);
            if (user != null)
            {
                CurrentUserSvc.SetUser(user);
            }
        }
    }

    private string GetRoleDisplay(User u)
    {
        if (u.Role == UserRole.Auditor) return "Auditor";
        if (apps != null && apps.Any(a => a.SystemOwnerId == u.Id)) return "System Owner";
        if (users != null && users.Any(x => x.ManagerId == u.Id)) return "Manager";
        return "Employee";
    }
}
